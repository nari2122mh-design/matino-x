# Copy this file to .env and fill in your own values.
# NEVER commit the .env file (it is already gitignored).

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=your_token_here

# Comma-separated chat IDs that are allowed to upload files.
# Leave empty to allow anyone (not recommended).
ALLOWED_CHAT_IDS=123456789

# Password used to log into the file-drop website (run_site.ps1).
SITE_PASSWORD=change_me
